# Port for the Express server
PORT=5000

# Environment mode (development / production)
NODE_ENV=development

# Frontend origin for CORS
CLIENT_URL=http://localhost:3000

# Database Configuration:
# Default uses local SQLite file: data/portfolio.sqlite
# To use PostgreSQL, set DIALECT=postgres and DATABASE_URL=postgres://user:password@localhost:5432/portfolio_db
DIALECT=sqlite
STORAGE_PATH=./data/portfolio.sqlite
# DATABASE_URL=postgres://postgres:password@localhost:5432/portfolio_db
