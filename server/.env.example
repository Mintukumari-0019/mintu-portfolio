# Port for the Express server
PORT=5000

# Environment mode (development / production)
NODE_ENV=development

# Frontend origin for CORS
CLIENT_URL=http://localhost:3000

# Admin Panel Authentication (REQUIRED)
# Secret passcode to unlock the admin dashboard (admin login disabled if missing/blank)
ADMIN_PASSCODE=change_this_to_a_strong_password
# Separate secret for signing admin session tokens (REQUIRED in production)
# In production, ADMIN_JWT_SECRET is strictly required; ADMIN_PASSCODE is never reused as the signing secret.
# In development, if omitted, an ephemeral key is generated in memory (tokens invalidate upon server restart).
ADMIN_JWT_SECRET=your_custom_jwt_signing_secret_here

# Database Configuration:
# Default uses local SQLite file: data/portfolio.sqlite
# To use PostgreSQL, set DIALECT=postgres and DATABASE_URL=postgres://user:password@localhost:5432/portfolio_db
DIALECT=sqlite
STORAGE_PATH=./data/portfolio.sqlite
# DATABASE_URL=postgres://postgres:password@localhost:5432/portfolio_db

# Optional Gmail / SMTP settings for direct in-app email replies
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=mkmintukumari.0987@gmail.com
# SMTP_PASS=your_gmail_app_password
